<?xml version="1.0" encoding="utf-8"?>
<manifest xmlns:android="http://schemas.android.com/apk/res/android"
    xmlns:tools="http://schemas.android.com/tools">

    <uses-permission android:name="android.permission.VIBRATE" />
    <!-- Camera scan when the device has no scan engine (scanner.trigger auto/camera). -->
    <uses-permission android:name="android.permission.CAMERA" />
    <!-- Dictation inside the keyboard (typing.voice); the audio goes to the device's speech recognition. -->
    <uses-permission android:name="android.permission.RECORD_AUDIO" />
    <!-- NFC tags into the focused field (scanner.nfc). -->
    <uses-permission android:name="android.permission.NFC" />

    <!-- No network, on purpose: nothing typed or recognised can leave the device. ML Kit (OCR)
         brings these through its usage statistics (datatransport); they are removed here. -->
    <uses-permission
        android:name="android.permission.INTERNET"
        tools:node="remove" />
    <uses-permission
        android:name="android.permission.ACCESS_NETWORK_STATE"
        tools:node="remove" />

    <!-- Camera and microphone are optional features: without these lines the CAMERA and RECORD_AUDIO
         permissions make Play require a rear camera and a microphone (2.2.4 lost 455 devices). -->
    <uses-feature
        android:name="android.hardware.camera.any"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.camera"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.camera.autofocus"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.microphone"
        android:required="false" />
    <uses-feature
        android:name="android.hardware.nfc"
        android:required="false" />

    <!-- Scanner services addressed via setPackage() for the soft scan trigger. -->
    <queries>
        <package android:name="com.symbol.datawedge" />
        <package android:name="com.intermec.datacollectionservice" />
        <!-- Dictation: the device's speech recognition service must be visible from Android 11 on. -->
        <intent>
            <action android:name="android.speech.RecognitionService" />
        </intent>
    </queries>

    <!-- allowBackup="false" already excludes everything up to Android 11, so no fullBackupContent;
         dataExtractionRules covers the device transfer from Android 12 on. -->
    <application
        android:name=".KeyboardApp"
        android:allowBackup="false"
        android:dataExtractionRules="@xml/data_extraction_rules"
        tools:ignore="DataExtractionRules"
        android:icon="@mipmap/ic_launcher"
        android:label="@string/app_name"
        android:roundIcon="@mipmap/ic_launcher_round"
        android:supportsRtl="true"
        android:theme="@style/Theme.IndustrialKeyboard">

        <meta-data
            android:name="android.content.APP_RESTRICTIONS"
            android:resource="@xml/app_restrictions" />

        <service
            android:name=".ime.KeyboardService"
            android:exported="true"
            android:label="@string/ime_name"
            android:permission="android.permission.BIND_INPUT_METHOD">
            <intent-filter>
                <action android:name="android.view.InputMethod" />
            </intent-filter>
            <meta-data
                android:name="android.view.im"
                android:resource="@xml/method" />
        </service>

        <activity
            android:name=".app.SetupActivity"
            android:exported="true"
            android:launchMode="singleTask"
            android:windowSoftInputMode="adjustResize">
            <intent-filter>
                <action android:name="android.intent.action.MAIN" />
                <category android:name="android.intent.category.LAUNCHER" />
            </intent-filter>
        </activity>

        <!-- Also opened from the system keyboard settings (method.xml). -->
        <activity
            android:name=".app.SettingsActivity"
            android:exported="true"
            android:label="@string/settings_title"
            android:windowSoftInputMode="stateHidden|adjustResize" />

        <!-- Snippets: the user's own (from the keyboard's ✎ and the setup screen) and, from the unlocked
             settings only, the administrator's. Not exported: no other app may open the admin mode. -->
        <activity
            android:name=".app.SnippetsActivity"
            android:exported="false"
            android:label="@string/snippets_title"
            android:windowSoftInputMode="adjustResize" />
        <activity
            android:name=".app.PersonalDictionaryActivity"
            android:exported="false"
            android:label="@string/personal_dictionary_title"
            android:windowSoftInputMode="adjustResize" />

        <!-- Asks for the camera permission for the keyboard (an input method cannot). -->
        <!-- Asks for the microphone permission for dictation (an input method cannot). -->
        <activity
            android:name=".app.MicrophonePermissionActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:theme="@style/Theme.IndustrialKeyboard.Transparent" />

        <activity
            android:name=".app.CameraPermissionActivity"
            android:excludeFromRecents="true"
            android:exported="false"
            android:theme="@style/Theme.IndustrialKeyboard.Transparent" />

        <!-- Reads a configuration QR code with the camera (settings, import from barcode). -->
        <activity
            android:name=".app.ConfigScanActivity"
            android:exported="false"
            android:theme="@style/Theme.IndustrialKeyboard" />

        <!-- NFC tags for the keyboard: an input method cannot read tags itself (reader mode needs
             an activity in front). Transparent, closes at once; the keyboard types the value. -->
        <activity
            android:name=".app.NfcTagActivity"
            android:excludeFromRecents="true"
            android:exported="true"
            android:launchMode="singleInstance"
            android:noHistory="true"
            android:taskAffinity=""
            android:theme="@style/Theme.IndustrialKeyboard.Transparent">
            <intent-filter>
                <action android:name="android.nfc.action.NDEF_DISCOVERED" />
                <category android:name="android.intent.category.DEFAULT" />
                <data android:mimeType="text/plain" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.nfc.action.TECH_DISCOVERED" />
            </intent-filter>
            <intent-filter>
                <action android:name="android.nfc.action.TAG_DISCOVERED" />
                <category android:name="android.intent.category.DEFAULT" />
            </intent-filter>
            <meta-data
                android:name="android.nfc.action.TECH_DISCOVERED"
                android:resource="@xml/nfc_tech_filter" />
        </activity>

        <!-- Configuration and tab switching by other apps or the MDM (explicit broadcasts). Without a
             permission on purpose: StageNow and MDM scripts cannot hold one. INSTALL_CONFIG checks
             the admin password itself (ApiReceiver, docs/deployment.md). -->
        <receiver
            android:name=".api.ApiReceiver"
            android:exported="true"
            tools:ignore="ExportedReceiver">
            <intent-filter>
                <action android:name="de.ictbaden.industrialkeyboard.action.INSTALL_CONFIG" />
                <action android:name="de.ictbaden.industrialkeyboard.action.SHOW_TAB" />
            </intent-filter>
        </receiver>
    </application>
</manifest>
