<?xml version="1.0" encoding="utf-8"?>
<!-- Keyboard languages (subtypes): Android enables those matching the system languages, more can be
     added under Settings → System → Keyboard → Industrial Keyboard → Languages. With
     layout.alphabet "auto" the letter layout follows the selected language (Alphabet.forLocale);
     only Latin-script languages, because the keyboard has no other scripts. -->
